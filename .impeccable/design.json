      "css": ".ds-chip{font-family:Manrope,sans-serif;font-variant-numeric:tabular-nums;min-height:40px;padding:8px 14px;font-size:12px;font-weight:650;font-variation-settings:\"wght\" 650;background:var(--surface,#fff);color:var(--muted,#65716c);border:0;border-radius:24px}.ds-chip[aria-pressed=true]{background:var(--green,#155442);color:var(--surface,#fff)}.ds-chip:focus-visible{outline:3px solid var(--focus,#38826a);outline-offset:3px}.ds-chip:active:not(:disabled){opacity:.74}.ds-chip:disabled{opacity:.45;cursor:default}.ds-chip:hover:not(:disabled){cursor:pointer}"
    },
    {
      "name": "Meta semanal compacta",
      "kind": "custom",
      "refersTo": "goal-compact",
      "description": "Primeira meta configurada e progresso; todas as metas ficam no diálogo Ver progresso. Prévia estática com valores ilustrativos, sem edição da meta.",
      "html": "<section class=\"ds-goal\"><header><h2>Metas da semana</h2><span>Semana atual</span></header><div class=\"ds-goal-value\"><span>Comissão</span><strong>R$ 0,00 <small>/ R$ 100,00</small></strong></div><div class=\"ds-goal-track\" role=\"progressbar\" aria-label=\"Meta de comissão\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"0\"><span></span></div><button>3 metas · Ver progresso<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button></section>",
      "css": ".ds-goal{font-family:Manrope,sans-serif;font-variant-numeric:tabular-nums;background:var(--surface,#fff);color:var(--ink,#1c2925);border-radius:16px;padding:16px 18px;margin-top:16px;min-height:0}.ds-goal>header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.ds-goal h2{font-size:15px;font-weight:750;margin:0}.ds-goal header>span{font-size:10px;color:var(--muted,#65716c)}.ds-goal-value{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:12px}.ds-goal-value strong{font-size:14px;color:var(--green,#155442);font-weight:750}.ds-goal-value small{font-size:11px;color:var(--muted,#65716c)}.ds-goal-track{margin-top:10px;height:6px;border-radius:3px;overflow:hidden;background:var(--progress-track,#e1ece5)}.ds-goal-track>span{height:100%;display:block;transform-origin:left;transform:scaleX(0);border-radius:3px;background:var(--green,#155442)}.ds-goal>button{font-family:Manrope,sans-serif;font-variant-numeric:tabular-nums;display:flex;align-items:center;justify-content:space-between;width:100%;margin-top:8px;min-height:38px;padding:8px 0 0;border:0;background:transparent;font-size:12px;color:var(--green,#155442)}.ds-goal>button:focus-visible{outline:3px solid var(--focus,#38826a);outline-offset:3px}.ds-goal>button:active:not(:disabled){opacity:.74}.ds-goal>button:disabled{opacity:.45;cursor:default}.ds-goal>button:hover:not(:disabled){cursor:pointer}"
    },
    {
      "name": "Saldo de destaque",
      "kind": "card",
      "refersTo": "card-balance",
      "description": "Estrutura do saldo do Início; valor da prévia é apenas ilustrativo.",
      "html": "<section class=\"ds-balance\"><h2>Recebido hoje</h2><strong>R$ 0,00</strong></section>",
      "css": ".ds-balance{font-family:Manrope,sans-serif;font-variant-numeric:tabular-nums;background:var(--green,#155442);border-radius:16px;color:var(--surface,#fff);padding:20px 22px;box-shadow:none;text-align:left}.ds-balance h2{font-size:15px;font-weight:650;font-variation-settings:\"wght\" 750;margin:0;color:inherit}.ds-balance>strong{display:block;color:inherit;font-size:36px;font-weight:750;font-variation-settings:\"wght\" 750;letter-spacing:-.035em;line-height:1.4;margin:18px 0 22px}"
    },
    {
      "name": "Abas do Caixa",
      "kind": "nav",
      "refersTo": "context-tabs",
      "description": "Alterna Hoje, Extrato e Repasses dentro do Caixa; a prévia mostra seleção estática.",
      "html": "<nav class=\"ds-context\" aria-label=\"Visões do Caixa\"><button aria-pressed=\"true\">Hoje</button><button aria-pressed=\"false\">Extrato</button><button aria-pressed=\"false\">Repasses</button></nav>",
      "css": ".ds-context{font-family:Manrope,sans-serif;font-variant-numeric:tabular-nums;display:flex;gap:4px;background:#ebefed;border-radius:12px;padding:4px}.ds-context button{font-family:Manrope,sans-serif;font-variant-numeric:tabular-nums;flex:1;border:0;border-radius:9px;color:var(--muted,#65716c);font-size:13px;font-weight:750;font-variation-settings:\"wght\" 650;min-height:44px;background:transparent}.ds-context button[aria-pressed=true]{background:var(--surface,#fff);color:var(--green,#155442)}.ds-context button:focus-visible{outline:3px solid var(--focus,#38826a);outline-offset:3px}.ds-context button:active:not(:disabled){opacity:.74}.ds-context button:disabled{opacity:.45;cursor:default}.ds-context button:hover:not(:disabled){cursor:pointer}"
    },
    {
      "name": "Linha financeira",
      "kind": "custom",
      "refersTo": "transaction-row",
      "description": "Descrição flexível e valor alinhado; demonstra a composição de pendências.",
      "html": "<button class=\"ds-money-row\"><span class=\"ds-money-icon\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 9h18M7 14h3\"/></svg></span><span class=\"ds-money-copy\"><strong>A receber de clientes</strong><small>Nenhum atendimento pendente</small></span><b>R$ 0,00</b><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></button>",
      "css": ".ds-money-row{font-family:Manrope,sans-serif;font-variant-numeric:tabular-nums;display:flex;align-items:center;gap:12px;min-height:85px;padding:18px 0;border:0;border-bottom:1px solid var(--line,#e4e9e6);width:100%;text-align:left;background:transparent;color:var(--ink,#1c2925)}.ds-money-icon{display:grid;place-items:center;width:42px;height:42px;flex:none;border-radius:13px;background:var(--amber-bg,#fff3df);color:var(--amber,#8b5814)}.ds-money-copy{display:flex;flex:1;min-width:0;flex-direction:column;gap:5px}.ds-money-copy strong{font-size:13px;font-weight:750;font-variation-settings:\"wght\" 750;overflow-wrap:anywhere}.ds-money-copy small{font-size:11px;color:var(--muted,#65716c);line-height:1.6}.ds-money-row>b{font-size:13px;flex:none;white-space:nowrap;font-weight:750;font-variation-settings:\"wght\" 750}.ds-money-row>svg{flex:none;color:var(--muted,#65716c)}.ds-money-row:focus-visible{outline:3px solid var(--focus,#38826a);outline-offset:3px}.ds-money-row:active:not(:disabled){opacity:.74}.ds-money-row:disabled{opacity:.45;cursor:default}.ds-money-row:hover:not(:disabled){cursor:pointer}"
    }
  ],
  "narrative": {
    "northStar": "Rotina por camadas",
    "overview": "A direção aprovada organiza a rotina do balcão em superfícies claras, valores legíveis e ações em verde. Cada tela apresenta seu contexto principal; listas, abas locais e grupos tonais expõem os detalhes conforme a tarefa, sem repetir o mesmo painel em todas as funções.\n\nGestão e Profissional compartilham a linguagem visual, preservando as permissões e o significado dos dados de cada edição. A densidade se adapta ao espaço: navegação inferior no celular, área ampla de trabalho no PC e detalhes em janelas ou painéis inferiores.",
    "keyCharacteristics": [
      "Fundo claro, superfícies brancas e verde reservado às ações e aos destaques operacionais.",
      "Manrope local, números tabulares e hierarquia por tamanho e peso.",
      "Listas por função, abas de contexto e detalhes progressivos.",
      "Início no centro da navegação inferior, com rótulos persistentes."
    ],
    "rules": [
      {
        "name": "The Context Color Rule",
        "body": "A cor apoia o tipo de ação ou o estado; não substitui o nome, a data, a situação nem o sinal do valor.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Novas telas dos dois shells usam Manrope local; não herdam Space Grotesk, DM Sans ou a tipografia da página pública.",
        "section": "typography"
      },
      {
        "name": "The Context First Rule",
        "body": "Cada função escolhe sua organização de dados: Agenda por dia/profissional, Caixa por Hoje/Extrato/Repasses e Relatórios por métrica/período. Não transformar essas telas em cópias do Início.",
        "section": "layout"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Use fundo, branco, menta e divisores para agrupar conteúdo; preserve sombras apenas nas camadas flutuantes existentes.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do manter Início no centro e os cinco destinos próprios de cada edição.",
      "Do usar Manrope local, números tabulares, reais com duas casas e períodos explícitos.",
      "Do agrupar registros em listas e escolher abas, gráficos e grupos tonais conforme a função.",
      "Do preservar foco visível, estados de carregamento/erro/vazio e movimento reduzido.",
      "Do preservar permissões por unidade/profissional e distinguir faturamento, recebimento, comissão, despesa e dinheiro na gaveta."
    ],
    "donts": [
      "Don't restaurar o carvão/Space Grotesk como identidade dos shells ou criar outra direção visual.",
      "Don't adicionar menus de navegação no topo ou transformar cada métrica em um cartão isolado.",
      "Don't usar valores dos protótipos como dados reais nem atribuir ao profissional a visão administrativa.",
      "Don't apresentar capturas com fixtures como validação em dispositivo real ou publicação em produção."
    ]
  }
}
