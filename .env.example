# Server-only configuration. Never expose these through VITE_.
DATABASE_URL=postgresql://usuario:senha@machado-app-db:5432/machado
DATABASE_SSL_CA_FILE=/run/secrets/database-ca
BETTER_AUTH_SECRET=preserve_o_segredo_real_ao_migrar
AUTH_BASE_URL=https://app-machado.45-140-203-243.sslip.io
HOSTING_PLATFORM=contabo
STORAGE_PROVIDER=filesystem
DATA_DIRECTORY=/var/lib/machado
APP_MODE=production
AGENT_ENABLED=false
# Use staging only while rehearsing in a separate database.
# APP_MODE=staging
# MIGRATION_TEST_TOKEN=segredo_de_homologacao
# Legacy Vercel/Neon support only:
# DATABASE_URL_UNPOOLED=postgresql://usuario:senha@servidor/neondb
# BLOB_READ_WRITE_TOKEN=token_privado
# BACKUP_READ_WRITE_TOKEN=token_privado
# CRON_SECRET=segredo_privado
